# Proveedor LLM activo: "nvidia", "gemini" u "openrouter"
LLM_PROVIDER=nvidia
LLM_REQUEST_TIMEOUT_SECONDS=30

# --- NVIDIA NIM (https://build.nvidia.com) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Seguridad ---
# Orígenes permitidos para CORS, separados por coma (sin espacios finales/barra final).
# El backend sirve el widget desde el mismo proceso/dominio (ver README), así que en
# el uso normal esto no hace falta — solo importa si embebés el widget en un dominio
# distinto (ej. un WordPress aparte) que llama a esta API desde el navegador.
ALLOWED_ORIGINS=http://localhost:8000
MAX_QUESTION_LENGTH=500
# Formato slowapi: "<cantidad>/<segundo|minuto|hora|dia>"
RATE_LIMIT=10/minute
